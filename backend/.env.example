# MongoDB + Neon Object Storage Backend Configuration

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gmit_sahaduta?retryWrites=true&w=majority

# Neon Object Storage (branch-scoped).
# Copy these values from the repo-root .env.local, which `neon deploy` /
# `neon env pull` writes (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3, AWS_REGION).
S3_ENDPOINT_URL=your_branch_s3_endpoint
S3_ACCESS_KEY_ID=your_neon_access_key
S3_SECRET_ACCESS_KEY=your_neon_secret_key
S3_BUCKET_NAME=uploads
S3_REGION=ap-southeast-1
# Bucket access level (private / public_read) is declared in neon.ts, not via S3 ACLs.

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5500

# JWT Secret (for admin auth)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Admin Credentials (initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kerjapraktik2025
